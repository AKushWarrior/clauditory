#!/usr/bin/env bash
# clauditory: list, install, package, build, and lint the artifacts in this repository.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  clauditory list
      Show every skill and system prompt in the repository.
  clauditory install <path-to-skill> [--dest DIR]
      Copy a skill into DIR/<skill-name> (default DIR: ~/.claude/skills).
  clauditory package <path-to-skill> [--out FILE]
      Build a zip of a skill for upload to the Claude apps
      (default FILE: ./<skill-name>.zip).
  clauditory build [--check]
      Regenerate plugins/clauditory from the skills under chat/skills and
      the system prompt at chat/system/prompt.md. With --check, report
      whether the plugin is out of date and change nothing.
  clauditory prompt
      Print the chat system prompt, for pasting or appending elsewhere.
  clauditory lint [flags] [file ...]
      Check prose with clauditory-lint, building it and Vale first if
      needed (requires Go). Pass --fix to apply the mechanical fixes, and
      run `clauditory lint --help` for the other flags.
  clauditory install-lint [--dest DIR]
      Build clauditory-lint and Vale and copy both into DIR (default
      ~/.local/bin), where the plugin's hook can find them.

The references/ folder and CHANGELOG.md are left out of installs and
packages, because they document the work for people and are not meant for
an agent's context.
EOF
}

skill_dir() {
  local dir="$ROOT/${1%/}"
  if [[ ! -f "$dir/SKILL.md" ]]; then
    echo "clauditory: no SKILL.md in $1" >&2
    exit 1
  fi
  echo "$dir"
}

# build_lint compiles clauditory-lint when its sources are newer than the
# binary, and installs Vale beside it when no Vale is on the PATH.
build_lint() {
  local bin="$ROOT/lint/.bin"
  if [[ ! -x "$bin/clauditory-lint" ]] || [[ -n "$(find "$ROOT/lint" -path "$bin" -prune -o \( -name '*.go' -o -name '*.yml' -o -name go.mod \) -newer "$bin/clauditory-lint" -print -quit)" ]]; then
    command -v go >/dev/null 2>&1 || { echo "clauditory: building the linter needs Go 1.24 or later" >&2; exit 1; }
    (cd "$ROOT/lint" && go build -o .bin/clauditory-lint ./cmd/clauditory-lint)
  fi
  if [[ -z "${CLAUDITORY_VALE:-}" && ! -x "$bin/vale" ]] && ! command -v vale >/dev/null 2>&1; then
    command -v go >/dev/null 2>&1 || { echo "clauditory: installing Vale needs Go 1.24 or later" >&2; exit 1; }
    echo "Installing Vale $VALE_VERSION into lint/.bin" >&2
    GOBIN="$bin" go install "github.com/vale-cli/vale/v3/cmd/vale@$VALE_VERSION"
  fi
}

VALE_VERSION=v3.26.0

cmd="${1:-}"
shift || true

case "$cmd" in
  list)
    echo "Skills:"
    find "$ROOT" \( -path "$ROOT/.git" -o -path "$ROOT/plugins" \) -prune -o -name SKILL.md -print \
      | sed "s|^$ROOT/||; s|/SKILL.md$||" | sort | sed 's/^/  /'
    echo "System prompts:"
    find "$ROOT" -path "$ROOT/.git" -prune -o -path '*/system/prompt.md' -print \
      | sed "s|^$ROOT/||" | sort | sed 's/^/  /'
    ;;
  install)
    src="$(skill_dir "${1:?clauditory: install needs a skill path}")"
    shift
    dest="$HOME/.claude/skills"
    if [[ "${1:-}" == "--dest" ]]; then dest="${2:?clauditory: --dest needs a directory}"; fi
    name="$(basename "$src")"
    mkdir -p "$dest/$name"
    (cd "$src" && find . \( -path ./references -o -name CHANGELOG.md \) -prune -o -type f -print \
      | while read -r f; do mkdir -p "$dest/$name/$(dirname "$f")"; cp "$f" "$dest/$name/$f"; done)
    echo "Installed $name to $dest/$name"
    ;;
  package)
    src="$(skill_dir "${1:?clauditory: package needs a skill path}")"
    shift
    name="$(basename "$src")"
    out="$PWD/$name.zip"
    if [[ "${1:-}" == "--out" ]]; then out="${2:?clauditory: --out needs a file name}"; fi
    rm -f "$out"
    (cd "$(dirname "$src")" && zip -qr "$out" "$name" -x "$name/references/*" "$name/CHANGELOG.md")
    echo "Packaged $name to $out"
    ;;
  build)
    plugin="$ROOT/plugins/clauditory"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/skills" "$tmp/output-styles" "$tmp/hooks"
    cp "$ROOT/lint/hooks/hooks.json" "$tmp/hooks/hooks.json"
    for dir in "$ROOT"/chat/skills/*/; do
      name="$(basename "$dir")"
      mkdir -p "$tmp/skills/$name"
      (cd "$dir" && find . \( -path ./references -o -name CHANGELOG.md \) -prune -o -type f -print \
        | while read -r f; do mkdir -p "$tmp/skills/$name/$(dirname "$f")"; cp "$f" "$tmp/skills/$name/$f"; done)
    done
    {
      printf -- '---\nname: clauditory\ndescription: "Clauditory working stance: evidence over agreement, explicit goals, parallel work, and plain prose"\nkeep-coding-instructions: true\nforce-for-plugin: true\n---\n\n'
      cat "$ROOT/chat/system/prompt.md"
    } > "$tmp/output-styles/clauditory.md"
    if [[ "${1:-}" == "--check" ]]; then
      if diff -r "$tmp/skills" "$plugin/skills" >/dev/null 2>&1 \
        && diff "$tmp/output-styles/clauditory.md" "$plugin/output-styles/clauditory.md" >/dev/null 2>&1 \
        && diff -r "$tmp/hooks" "$plugin/hooks" >/dev/null 2>&1; then
        echo "plugins/clauditory is up to date"
      else
        echo "plugins/clauditory is out of date; run bin/clauditory build" >&2
        exit 1
      fi
    else
      rm -rf "$plugin/skills" "$plugin/output-styles" "$plugin/hooks"
      mkdir -p "$plugin"
      cp -R "$tmp/skills" "$tmp/output-styles" "$tmp/hooks" "$plugin/"
      echo "Built plugins/clauditory"
    fi
    ;;
  prompt)
    cat "$ROOT/chat/system/prompt.md"
    ;;
  lint)
    build_lint
    exec "$ROOT/lint/.bin/clauditory-lint" "$@"
    ;;
  install-lint)
    build_lint
    dest="$HOME/.local/bin"
    if [[ "${1:-}" == "--dest" ]]; then dest="${2:?clauditory: --dest needs a directory}"; fi
    mkdir -p "$dest"
    cp "$ROOT/lint/.bin/clauditory-lint" "$dest/"
    if [[ -x "$ROOT/lint/.bin/vale" ]]; then cp "$ROOT/lint/.bin/vale" "$dest/"; fi
    echo "Installed clauditory-lint to $dest"
    case ":$PATH:" in *":$dest:"*) ;; *) echo "Add $dest to your PATH so the plugin's hook can find it." ;; esac
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "clauditory: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
